# ==========================================
# StudyRoom Environment Configuration Sample
# ==========================================

# Backend server port
SERVER_PORT=8080

# Spring active profile: leave empty for local file-based H2 database,
# or set to "postgres" to use PostgreSQL.
SPRING_PROFILES_ACTIVE=

# PostgreSQL settings (used when SPRING_PROFILES_ACTIVE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyroom
DB_USERNAME=studyroom
DB_PASSWORD=studyroom123

# JWT security (generate a strong Base64 256-bit secret in production)
JWT_SECRET=c3R1ZHlyb29tLW12cC1kZXYtanVzdC1mb3ItbG9jYWwtdGVzdGluZy0yMDI2LXNlY3JldC1rZXk=
JWT_EXPIRATION_MS=86400000

# CORS allowed frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed sample Teacher/Student accounts on initial startup
SEED_ENABLED=true

# Frontend Vite API & WebSocket base URL (see frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/ws/meeting
